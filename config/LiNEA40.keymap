#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,,,,,,,,,,,,,,,,,,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        ZenkakuHankaku {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        DeleteKey {
            bindings = <&kp DEL>;
            key-positions = <7 8>;
        };

        InsertKey {
            bindings = <&kp INS>;
            key-positions = <6 7>;
        };

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <17 16>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <18 17>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <27 28>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <26 27>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        lt_dt: lt_doubletap {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_DoubleTap";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <200>;
            hold-while-undecided;
        };

        mt_shift: mt_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "Mod/Tap_shift";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                   &kp W               &kp E         &kp R    &kp T                                              &kp Y           &kp U  &kp I                &kp O          &kp P
&kp A                   &kp S               &kp D         &kp F    &kp G                                              &kp H           &kp J  &kp K                &kp L          &lt 5 MINUS
&mt_shift LEFT_SHIFT Z  &kp X               &kp C         &kp V    &kp B                                              &kp N           &kp M  &kp COMMA            &kp DOT        &mt RIGHT_SHIFT COLON
&mt LCTRL ESC           &mt LEFT_ALT GRAVE  &kp LEFT_GUI  &kp INS  &lt_dt 1 SPACE  &lt 2 GRAVE    &lt_dt 3 BACKSPACE  &lt_dt 4 ENTER         &lt 6 RIGHT_BRACKET  &kp BACKSLASH  &kp SLASH
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        MOUSE {
            bindings = <
&trans  &trans                  &kp LG(D)                          &trans                                  &trans                     &trans  &kp LEFT  &kp UP    &kp RIGHT  &trans
&trans  &kp LC(LG(LEFT_ARROW))  &kp LG(TAB)                        &kp LC(LG(RIGHT))                       &trans                     &trans  &mkp MB1  &kp DOWN  &mkp MB2   &trans
&trans  &trans                  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS  &trans                     &trans  &mkp MB4  &mkp MB3  &mkp MB5   &trans
&trans  &trans                  &trans                             &trans                                  &trans  &trans    &kp DEL  &trans            &trans    &trans     &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        MARK {
            bindings = <
&kp EXCLAMATION  &kp AT          &kp HASH          &kp DOLLAR        &kp PERCENT                       &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp LBKT
&kp TAB          &kp LANGUAGE_2  &kp LANG_HANGEUL  &kp INT_MUHENKAN  &kp INT_HENKAN                    &none      &kp EQUAL      &kp INT3      &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&kp LEFT_SHIFT   &none           &none             &none             &none                             &none      &none          &kp SEMI      &kp APOS              &kp BACKSLASH
&trans           &trans          &trans            &trans            &trans          &trans    &trans  &trans                    &kp ASTERISK  &kp SLASH             &kp INT1
            >;

            sensor-bindings = <&re_kp C_VOLUME_UP C_VOL_DN>;
        };

        FUNCTION {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5                               &kp F6      &kp F7  &kp F8               &kp F9              &kp F10
&kp F6  &kp F7  &kp F8  &kp F9   &kp F10                              &trans      &trans  &kp LS(LG(S))        &kp F11             &kp F12
&trans  &trans  &trans  &kp F11  &kp F12                              &kp C_MUTE  &trans  &kp LA(PRINTSCREEN)  &trans              &kp LC(LA(INS))
&trans  &trans  &trans  &trans   &trans   &kp LS(LEFT_ALT)    &trans  &trans              &trans               &kp LC(LA(DELETE))  &kp LC(LS(ESCAPE))
            >;

            sensor-bindings = <&re_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        CURSOR {
            bindings = <
&trans    &kp LC(LG(LEFT_ARROW))  &kp UP_ARROW  &kp LC(LG(RIGHT_ARROW))  &trans                       &kp KP_DIVIDE    &kp N7        &kp N8         &kp N9        &kp KP_MINUS
&trans    &kp LEFT_ARROW          &kp DOWN      &kp RIGHT_ARROW          &trans                       &kp KP_MULTIPLY  &kp NUMBER_4  &kp N5         &kp NUMBER_6  &kp KP_PLUS
&kp HOME  &kp PAGE_DOWN           &kp END       &kp PAGE_UP              &trans                       &kp N0           &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3  &kp PERCENT
&trans    &trans                  &trans        &trans                   &trans  &trans    &kp ENTER  &trans                         &kp BACKSPACE  &kp DOT       &kp MINUS
            >;

            sensor-bindings = <&mouse_scrl SCRL_RIGHT SCRL_LEFT>;
        };

        SCROLL {
            bindings = <
&trans    &kp LC(LG(LEFT_ARROW))  &kp UP_ARROW  &kp LC(LG(RIGHT_ARROW))  &trans                    &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_PLUS
&trans    &kp LEFT_ARROW          &kp DOWN      &kp RIGHT_ARROW          &trans                    &kp KP_SLASH     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MINUS
&kp HOME  &kp PAGE_DOWN           &kp END       &kp PAGE_UP              &trans                    &kp UNDER        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ENTER
&trans    &trans                  &trans        &trans                   &trans  &trans    &trans  &kp NUMBER_0                   &kp NUMBER_0  &kp DOT       &kp QUESTION
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };
    };
};
